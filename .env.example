# Postgres
POSTGRES_USER=twinai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=twinai
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=4000
# 32-byte key (base64) used for AES-256-GCM encryption of stored API credentials.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace-with-a-generated-32-byte-base64-key
# Signs session cookies. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-generated-session-secret
# Anthropic API key owned by the platform itself (not a tenant's BYOK
# credential), used only by the public pre-signup copilot demo on the
# landing page. Optional — leave blank and that widget shows a "not
# configured" message instead of crashing the app.
PLATFORM_COPILOT_API_KEY=
# Optional overrides for the default AI model used by the script-generation
# and copilot providers — leave blank to use the registry's current default
# (see backend/src/services/providers/providerRegistry.ts).
ANTHROPIC_MODEL=
GEMINI_MODEL=
OPENAI_MODEL=
# Optional base URL override for the OpenAI vendor's generic
# openai-chat-completions adapter — leave blank to use
# https://api.openai.com/v1. Point this at an OpenAI-compatible endpoint
# (self-hosted, proxy, etc.) to swap providers without touching the adapter.
OPENAI_BASE_URL=

# Frontend
FRONTEND_PORT=5173
# Full international number, digits only (e.g. 5511999999999), used to build
# the "Fale conosco" wa.me link on the landing page. Optional — the link is
# hidden when this is blank.
WHATSAPP_NUMBER=

# Traefik (host port for the whole app)
TRAEFIK_HTTP_PORT=8090

# Domain config — MOCKED until a real domain is decided (see backend/src/domainConfig.ts).
# ".localhost" (not ".local") resolves to 127.0.0.1 natively in modern
# browsers — no /etc/hosts entries needed for local dev. Plain "localhost"
# (no ".localhost" suffix) no longer keeps you logged in once the session
# cookie is scoped to BASE_DOMAIN — see docs/setup.md.
BASE_DOMAIN=twinai.localhost
# One of: cloudflare | route53 | registro.br (pending final choice)
DNS_PROVIDER=pending
# ACME DNS-01 provider API credentials (needed for wildcard TLS in production
# — HTTP-01 doesn't cover wildcard certs). Left blank/commented until
# DNS_PROVIDER is decided; app runs over plain HTTP locally without these.
# CLOUDFLARE_API_TOKEN=
# ROUTE53_ACCESS_KEY_ID=
# ROUTE53_SECRET_ACCESS_KEY=

# Stripe (Fase 4 — billing plan). Platform's own account, test-mode keys for
# local dev (never live/production keys). Optional — the app boots fine
# without these; /subscription/checkout and the webhook route return a clear
# "not configured" error instead of crashing.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Printed by `stripe listen --forward-to <url>` when running locally —
# different from any dashboard-configured webhook secret. See docs/setup.md.
STRIPE_WEBHOOK_SECRET=

# --- Modo dos provedores tarifados (HeyGen / ElevenLabs) -----------------
# fixture = devolve artefatos locais, sem tocar a rede (padrão em
#           desenvolvimento). live = chama os fornecedores de verdade.
# npm run check REPROVA o build se fixture estiver ativo com
# NODE_ENV=production — simular geração para cliente cobrado seria mentira.
PROVIDER_MODE=fixture

# --- Chaves de plataforma: CINCO, distintas ------------------------------
#
# A ORIGEM PREFERIDA destas chaves é o painel admin (aba "APIs" → "Chaves da
# plataforma"), que as grava cifradas na tabela `platform_credentials`. Gravar
# ali vale sem reiniciar o backend, deixa rastro de quem gravou, e não expõe o
# valor na tela nem no scrollback do terminal.
#
# As variáveis abaixo continuam valendo como RETAGUARDA, para o que ainda não
# foi gravado — e como forma de subir um ambiente novo antes de existir um
# admin para gravar.
#
# Copiloto público e do admin. DEVE ser Anthropic: askCopilot() usa vendor
# "anthropic" por padrão, então uma chave Google aqui vira 401.
PLATFORM_COPILOT_API_KEY=
# Google, com créditos: copiloto do TENANT. Enquanto vazia, o copiloto do
# tenant cai na BYOK do cliente (retaguarda temporária).
PLATFORM_GOOGLE_API_KEY=
# Google, só embeddings (gemini-embedding-001 a 1536 dims). Separada da de
# roteiro de propósito: indexar em lote não pode consumir a cota do suporte.
PLATFORM_EMBEDDING_API_KEY=
# HeyGen e ElevenLabs DA PLATAFORMA. Hoje só armazenadas e validadas pelo
# painel — o caminho de geração continua lendo a credencial do tenant. Migrar
# a geração para cá muda quem paga a conta, e é decisão de negócio separada.
PLATFORM_HEYGEN_API_KEY=
PLATFORM_ELEVENLABS_API_KEY=

# Inverte a precedência acima: com "1", o .env vence o painel. Saída de
# emergência para o caso de uma chave ruim gravada pela tela trancar do lado
# de fora justo quem precisaria entrar para consertá-la. Deixe VAZIO em
# operação normal, senão gravar pelo painel não terá efeito.
PLATFORM_KEYS_FORCE_ENV=

# --- Limiter de login ----------------------------------------------------
# Vazio = valor de produção (5 tentativas / 15 min). Afrouxar só em
# desenvolvimento; o check reprova valor folgado com NODE_ENV=production.
LOGIN_RATE_LIMIT_MAX=
LOGIN_RATE_LIMIT_WINDOW_MS=

# --- Acesso de desenvolvimento -------------------------------------------
# DEV_AUTOFILL=1 preenche os formulários de login. Os valores ficam só no
# .env (fora do git) — nunca no fonte. Ver DEV-ACCESS.local.md.
DEV_AUTOFILL=
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
DEV_TENANT_EMAIL=
DEV_TENANT_PASSWORD=
DEV_TENANT_SLUG=

# --- Galeria de desenvolvimento (/dev/steps) -----------------------------
# DEV_GALLERY=1 registra a rota da galeria de passos. Em produção a rota não
# pode existir; o check reprova a flag ligada com NODE_ENV=production.
DEV_GALLERY=

# --- Trava de gasto real -------------------------------------------------
# PROVIDER_MODE=live NÃO basta: exige a frase exata abaixo, senão o servidor
# recusa subir. Em live cada geração consome cota PAGA.
PROVIDER_LIVE_CONFIRM=
# Teto de gerações tarifadas por sessão (default 1 — a carteira comporta ~1
# vídeo). Vale só em live; em fixture nada é consumido.
PROVIDER_LIVE_MAX_GENERATIONS=
