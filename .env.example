# Postgres
POSTGRES_USER=twinai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=twinai
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=4000
# 32-byte key (base64) used for AES-256-GCM encryption of stored API credentials.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace-with-a-generated-32-byte-base64-key
# Signs session cookies. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-generated-session-secret
# Anthropic API key owned by the platform itself (not a tenant's BYOK
# credential), used only by the public pre-signup copilot demo on the
# landing page. Optional — leave blank and that widget shows a "not
# configured" message instead of crashing the app.
PLATFORM_COPILOT_API_KEY=
# Optional overrides for the default AI model used by the script-generation
# and copilot providers — leave blank to use the registry's current default
# (see backend/src/services/providers/providerRegistry.ts).
ANTHROPIC_MODEL=
GEMINI_MODEL=
OPENAI_MODEL=
# Optional base URL override for the OpenAI vendor's generic
# openai-chat-completions adapter — leave blank to use
# https://api.openai.com/v1. Point this at an OpenAI-compatible endpoint
# (self-hosted, proxy, etc.) to swap providers without touching the adapter.
OPENAI_BASE_URL=

# Frontend
FRONTEND_PORT=5173
# Full international number, digits only (e.g. 5511999999999), used to build
# the "Fale conosco" wa.me link on the landing page. Optional — the link is
# hidden when this is blank.
WHATSAPP_NUMBER=

# Traefik (host port for the whole app)
TRAEFIK_HTTP_PORT=8090

# Domain config — MOCKED until a real domain is decided (see backend/src/domainConfig.ts).
# ".localhost" (not ".local") resolves to 127.0.0.1 natively in modern
# browsers — no /etc/hosts entries needed for local dev. Plain "localhost"
# (no ".localhost" suffix) no longer keeps you logged in once the session
# cookie is scoped to BASE_DOMAIN — see docs/setup.md.
BASE_DOMAIN=twinai.localhost
# One of: cloudflare | route53 | registro.br (pending final choice)
DNS_PROVIDER=pending
# ACME DNS-01 provider API credentials (needed for wildcard TLS in production
# — HTTP-01 doesn't cover wildcard certs). Left blank/commented until
# DNS_PROVIDER is decided; app runs over plain HTTP locally without these.
# CLOUDFLARE_API_TOKEN=
# ROUTE53_ACCESS_KEY_ID=
# ROUTE53_SECRET_ACCESS_KEY=

# Stripe (Fase 4 — billing plan). Platform's own account, test-mode keys for
# local dev (never live/production keys). Optional — the app boots fine
# without these; /subscription/checkout and the webhook route return a clear
# "not configured" error instead of crashing.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Printed by `stripe listen --forward-to <url>` when running locally —
# different from any dashboard-configured webhook secret. See docs/setup.md.
STRIPE_WEBHOOK_SECRET=
